# Adelaide configuration — copy to .env (never commit .env) or set as environment variables.
#
# Nothing here is needed for the demo: scripts/run-demo.sh sets ADELAIDE_DEMO_MODE=1 and local paths, and demo mode
# REFUSES to start if any of the "real services" settings below are present.
# There are no built-in defaults for tenants, sites or endpoints: a missing required value fails at startup by name.

# ── Demo mode ──────────────────────────────────────────────────────────────────────────────────────────────────────
# ADELAIDE_DEMO_MODE=1                       # synthetic corpus + local adapters, outbound network blocked
# ADELAIDE_DEMO_DATA=demo                    # fixtures.json / patients.json (default: nearest demo/ folder)
# ADELAIDE_DEMO_FILED=.adelaide-demo/filed   # where the local filer writes

# ── Local runtime state ────────────────────────────────────────────────────────────────────────────────────────────
ADELAIDE_AUDIT_DB=adelaide-audit.db          # SQLite hash-chained ledger (used when no ADELAIDE_SQL_* is set)
ADELAIDE_INBOX=inbox                         # captured uploads + review/filing sidecars (holds PHI in real use)
ADELAIDE_LOG_DIR=logs                        # rolling JSON-lines logs (PHI-free by design)
# ADELAIDE_TRANSCRIPT_DB=                    # capture store override (defaults beside the audit DB)
# ASPNETCORE_URLS=http://localhost:8123

# Development-only local identity (Reviewer + Admin). Honoured ONLY when ASPNETCORE_ENVIRONMENT=Development.
# ASPNETCORE_ENVIRONMENT=Development
# ADELAIDE_DEV_ACTOR=local-dev

# ── Real services: Microsoft Graph / SharePoint (app-only) ─────────────────────────────────────────────────────────
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=                         # or load from Key Vault (ADELAIDE_KEYVAULT_URI)
SP_SITE_ID=contoso.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000
# SP_BUSINESS_SITE_ID=                       # optional separate site for non-patient documents
# SP_BUSINESS_LIBRARY=Business – Eingang
# SP_BUSINESS_CONTENT_TYPE=Document

# ── Real services: Azure OpenAI + Document Intelligence (keyless — Entra token via the credential above) ──────────
ADELAIDE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
ADELAIDE_OPENAI_DEPLOYMENT=gpt-4o
ADELAIDE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
ADELAIDE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# ── Cloud deployment (optional) ────────────────────────────────────────────────────────────────────────────────────
# ADELAIDE_SQL_SERVER=<server>.database.windows.net   # Azure SQL ledger + capture store (managed identity)
# ADELAIDE_SQL_DATABASE=<database>
# ADELAIDE_KEYVAULT_URI=https://<vault>.vault.azure.net/
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# ADELAIDE_EASYAUTH_VALIDATE=true                     # cryptographically validate the forwarded Entra ID token
# ADELAIDE_EASYAUTH_TENANT_ID=
# ADELAIDE_EASYAUTH_CLIENT_ID=

# ── Scanner/fax intake (optional) ──────────────────────────────────────────────────────────────────────────────────
# ADELAIDE_DRAIN_SHARE_URL=https://<account>.file.core.windows.net/<share>?<sas>   # in-app staging-share poller
# ADELAIDE_DRAIN_SHARE_SUBDIR=
# ADELAIDE_DRAIN_AUTH_TENANT=                         # enables POST /api/drain/upload (app-only bearer, "Drain" role)
# ADELAIDE_DRAIN_AUTH_AUDIENCE=

# ── Hardening / operations (optional) ──────────────────────────────────────────────────────────────────────────────
# ADELAIDE_CLAMAV_HOST=localhost                      # enables fail-closed malware scanning of uploads
# ADELAIDE_RATE_LIMIT_PER_MINUTE=30
# ADELAIDE_CONCURRENCY=4
# ADELAIDE_RECONCILE_MINUTES=2
# ADELAIDE_PURGE_ENABLED=1                            # allow deletion of filed/discarded inputs (default: preserve)
# ADELAIDE_FILED_PURGE_GRACE_DAYS=14
# ADELAIDE_TRANSCRIPT_RETENTION_DAYS=365
