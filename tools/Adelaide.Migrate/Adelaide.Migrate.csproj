<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Adelaide.Migrate</RootNamespace>
    <AssemblyName>Adelaide.Migrate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The two audit stores (SqliteAuditStore for the source + its chain verify; AzureSqlAuditStore for the target verify)
         and the shared ChainVerification type. Adelaide.Audit already pulls Microsoft.Data.Sqlite + Microsoft.Data.SqlClient
         + Azure.Identity; they are re-declared below since this tool opens the connections directly. -->
    <ProjectReference Include="..\..\src\Adelaide.Audit\Adelaide.Audit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" /><!-- pins the native SQLite past GHSA-2m69-gcr7-jv3q (<= 2.1.11); Microsoft.Data.Sqlite still floors at 2.1.11 -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

</Project>
