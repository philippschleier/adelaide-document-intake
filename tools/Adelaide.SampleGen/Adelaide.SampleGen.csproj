<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the FICTIONAL demo corpus (demo/samples/*.pdf + demo/fixtures.json + demo/patients.json).
       Deterministic: no timestamps or random ids, so re-running it reproduces byte-identical PDFs and SHA-256 keys. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Adelaide.Core\Adelaide.Core.csproj" />
    <ProjectReference Include="..\..\src\Adelaide.Demo\Adelaide.Demo.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
